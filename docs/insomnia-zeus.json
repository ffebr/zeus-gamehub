      "headers": [],
      "body": {},
      "parameters": []
    },
    {
      "_id": "__request_12__",
      "_type": "request",
      "parentId": "__WORKSPACE_ID__",
      "name": "Поток уведомлений (SSE)",
      "method": "GET",
      "url": "{{ base_url }}/api/notifications/stream",
