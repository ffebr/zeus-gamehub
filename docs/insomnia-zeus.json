    },
    {
      "_id": "__request_1__",
      "_type": "request",
      "parentId": "__folder_1__",
      "name": "Создать или обновить профиль",
      "method": "POST",
      "url": "{{ base_url }}/api/players/{{ player_id }}",
      "description": "При повторном обновлении отправляет уведомление в Redis Stream.",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Player 1001\",\n  \"level\": 3,\n  \"region\": \"eu\"\n}"
      },
      "parameters": []
    },
    {
      "_id": "__request_2__",
      "_type": "request",
      "parentId": "__folder_1__",
      "name": "Получить профиль",
      "method": "GET",
      "url": "{{ base_url }}/api/players/{{ player_id }}",
      "description": "Повторный запрос использует кэш Redis с TTL 60 секунд.",
      "headers": [],
      "body": {},
      "parameters": []
    },
    {
      "_id": "__request_3__",
      "_type": "request",
      "parentId": "__folder_1__",
      "name": "Изменить уровень",
      "method": "PATCH",
      "url": "{{ base_url }}/api/players/{{ player_id }}/level",
      "description": "Меняет уровень и записывает уведомление в Redis Stream.",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": { "mimeType": "application/json", "text": "{\n  \"delta\": 2\n}" },
      "parameters": []
    },
    {
      "_id": "__request_4__",
      "_type": "request",
      "parentId": "__folder_1__",
      "name": "Зафиксировать вход",
      "method": "POST",
      "url": "{{ base_url }}/api/players/{{ player_id }}/login",
      "description": "Увеличивает счётчик входов с TTL 24 часа.",
      "headers": [],
      "body": {},
      "parameters": []
    },
    {
      "_id": "__request_5__",
      "_type": "request",
      "parentId": "__folder_1__",
      "name": "Пакетная запись профилей",
      "method": "POST",
      "url": "{{ base_url }}/api/players/batch",
      "description": "Записывает от 1 до 100 профилей через Lettuce pipeline.",
      "headers": [{ "name": "Content-Type", "value": "application/json" }],
      "body": {
        "mimeType": "application/json",
        "text": "[\n  { \"id\": \"2001\", \"name\": \"Alice\", \"level\": 1, \"region\": \"eu\" },\n  { \"id\": \"2002\", \"name\": \"Bob\", \"level\": 2, \"region\": \"us\" }\n]"
      },
      "parameters": []
    },
    {
