      "headers": [],
      "body": {},
      "parameters": []
    },
    {
      "_id": "__request_11__",
      "_type": "request",
      "parentId": "__folder_3__",
      "name": "Общие достижения",
      "method": "GET",
      "url": "{{ base_url }}/api/players/{{ player_id }}/achievements/common/{{ other_player_id }}",
